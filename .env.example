# Copy to .env (Git-ignored; chmod 600 on Linux/macOS) on the machine the receiver is plugged into, for pc/uplink.py.
PLAYCE_BACKEND_URL=https://playce-admin.mooo.com
# Same value as KHUROUND_RFID_UPLINK_TOKEN in the backend's .env. It only allows sending receiver lines.
KHUROUND_RFID_UPLINK_TOKEN=
